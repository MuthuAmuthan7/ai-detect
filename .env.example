# Model & Path Settings
MODEL_PATH=models/detector/model.onnx
VAD_MODEL_PATH=models/vad/silero_vad.onnx
HF_MODEL_NAME=garystafford/wav2vec2-deepfake-voice-detector

# Audio Sampling Config
AUDIO_SAMPLE_RATE=16000
INPUT_SAMPLE_RATE=8000
WINDOW_SECONDS=3.0
STRIDE_SECONDS=1.0

# VAD Settings
VAD_THRESHOLD=0.5
MIN_SPEECH_DURATION_MS=300
MIN_SILENCE_DURATION_MS=300
SHORT_SILENCE_MS=300
LONG_SILENCE_MS=1500

# Classification Thresholds & Smoothing
AI_THRESHOLD=0.90
HUMAN_THRESHOLD=0.10
EMA_ALPHA=0.4
AI_CONFIRMATIONS=2
HUMAN_CONFIRMATIONS=3

# ONNX Runtime Execution Settings
ONNX_PROVIDER=cpu
ORT_INTRA_OP_THREADS=4
ORT_INTER_OP_THREADS=1

# Server Concurrency & Queues
MAX_ACTIVE_CALLS=100
MAX_AUDIO_QUEUE_SIZE=1000
MAX_INFERENCE_QUEUE_SIZE=100
